# 운영 compose(compose.data.yml, compose.app.yml) 변수 목록. 실제 값은 레포 밖의 권한 제한된 파일에 둔다.
# 아래 값은 예시이며 운영 비밀값이 아니다
POSTGRES_USER=shop_sim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop_sim

# 앱 이미지. 배포 에이전트가 새 태그로 바꾼다(ADR 0014)
API_IMAGE=ghcr.io/learn-shop-fullstack/shop-sim-api:example
WORKER_IMAGE=ghcr.io/learn-shop-fullstack/shop-sim-worker:example
# web 이미지는 API 주소가 빌드에 들어가 환경(staging·production)마다 태그가 다르다(ADR 0020)
STORE_IMAGE=ghcr.io/learn-shop-fullstack/shop-sim-store:example
SELLER_IMAGE=ghcr.io/learn-shop-fullstack/shop-sim-seller:example
ADMIN_IMAGE=ghcr.io/learn-shop-fullstack/shop-sim-admin:example
# 서비스 주소. 같은 프로젝트면 서비스 이름(postgres)을 쓴다. 계정은 위 POSTGRES_* 값과 맞춘다
DATABASE_URL=postgres://shop_sim:change-me@postgres:5432/shop_sim
