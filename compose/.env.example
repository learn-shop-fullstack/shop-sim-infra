# 운영 compose(compose.data.yml, compose.app.yml) 변수 목록. 실제 값은 레포 밖의 권한 제한된 파일에 둔다.
# 아래 값은 예시이며 운영 비밀값이 아니다
POSTGRES_USER=shop_sim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop_sim

# 앱 이미지(*_IMAGE)는 비밀값이 아니라 배포 상태라 레포의 ../deploy/<환경>.env에 둔다(ADR 0025)
# 서비스 주소. 같은 프로젝트면 서비스 이름(postgres)을 쓴다. 계정은 위 POSTGRES_* 값과 맞춘다
DATABASE_URL=postgres://shop_sim:change-me@postgres:5432/shop_sim

# 터널(ADR 0022). 설정은 ../cloudflared/<값>.yml(production 또는 staging)
CLOUDFLARED_CONFIG=production
# 터널 자격 증명 JSON의 절대 경로. 레포 밖에 둔다
CLOUDFLARED_CREDENTIALS_FILE=/path/to/shop-sim-production.json
