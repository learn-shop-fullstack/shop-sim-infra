# cp .env.example .env 후 사용. 개발용 값이며 운영 비밀값이 아니다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shop_sim
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333
S3_ACCESS_KEY_ID=localdev
S3_SECRET_ACCESS_KEY=localdevsecret
S3_BUCKET=shop-sim-images
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_UI_READONLY=true
