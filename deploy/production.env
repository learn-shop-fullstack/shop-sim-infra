# production 환경에 배포할 앱 이미지 (ADR 0025). 이 파일의 main이 배포 상태다. 머지하면 배포 에이전트가 1분 안에 적용한다
# 비밀값을 넣지 않는다(비밀값은 ~/.config/shop-sim/production/compose.env). 값이 비어 있으면 아직 배포할 이미지가 없다는 뜻이다
API_IMAGE=
WORKER_IMAGE=
# web 이미지는 API 주소가 빌드에 들어가 태그에 환경 접두어가 붙는다(<환경>-sha-<7자>, ADR 0024)
STORE_IMAGE=
SELLER_IMAGE=
ADMIN_IMAGE=
